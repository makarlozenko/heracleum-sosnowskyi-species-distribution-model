# Keep code and documentation portable.
* text=auto eol=lf

# Preserve every source dataset byte-for-byte, including JSON and raster sidecars.
data/raw/** filter=lfs diff=lfs merge=lfs -text

# Store derived tables and spatial data through LFS as well.
data/processed/*.csv filter=lfs diff=lfs merge=lfs -text
data/processed/*.gpkg filter=lfs diff=lfs merge=lfs -text
